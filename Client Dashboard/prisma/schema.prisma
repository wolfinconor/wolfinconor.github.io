generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id         String   @id @default(cuid())
  shareToken String   @unique
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  properties Property[]
}

model Property {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  listingUrl String?
  imageUrl   String?
  address    String?
  city       String?
  price      Int?
  notes      String?

  status     String  @default("comparing") // "comparing" | "active" | "closed"
  order      Int     @default(0)
  isFavorite Boolean @default(false)

  offerAcceptedDate  DateTime?
  targetClosingDate  DateTime?
  currentStatusLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timelineSteps TimelineStep[]
  nextSteps     NextStep[]
  costItems     CostItem[]
  todoItems     TodoItem[]
}

model TimelineStep {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  date       String
  order      Int
  status     String // "done" | "current" | "upcoming"
}

model NextStep {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  text       String
  dueDate    String
  order      Int      @default(0)
  status     String // "open" | "done"
}

model CostItem {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  amount     Int // stored in whole dollars
  order      Int
  isTotal    Boolean  @default(false)
}

model TodoItem {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  text       String
  assignedTo String
  order      Int      @default(0)
  status     String // "open" | "done"
}
